generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum EstadoCita {
  CONFIRMADA
  CANCELADA
  ATENDIDA
  NO_PRESENTADA
}

enum TipoEmail {
  CONFIRMACION_PACIENTE
  AVISO_CLINICA
  RECORDATORIO
  CANCELACION
  MODIFICACION
  ACCESO // invitación al panel o cambio de contraseña
}

enum CanalMensaje {
  WHATSAPP
  SMS
  CONSOLA
}

enum Rol {
  ADMIN // además: configuración y usuarios
  EQUIPO // agenda, citas, pacientes, bloqueos y emails
}

enum CanalEmail {
  RESEND
  CONSOLA
}

model Profesional {
  id       String           @id @default(cuid())
  slug     String           @unique
  nombre   String
  titulo   String
  bio      String
  orden    Int              @default(0)
  activo   Boolean          @default(true)
  usuarios Usuario[]
  horarios HorarioLaboral[]
  citas    Cita[]
  bloqueos Bloqueo[]
  franjas  FranjaOcupada[]

  @@map("profesionales")
}

model Servicio {
  id          String  @id @default(cuid())
  slug        String  @unique
  nombre      String
  descripcion String
  duracionMin Int
  precioCent  Int
  orden       Int     @default(0)
  activo      Boolean @default(true)
  citas       Cita[]

  @@map("servicios")
}

// Un tramo de trabajo. L-V son dos filas por día (mañana y tarde).
model HorarioLaboral {
  id            String      @id @default(cuid())
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  diaSemana     Int // 1 = lunes … 7 = domingo
  minInicio     Int // minutos desde medianoche, hora de Madrid (540 = 9:00)
  minFin        Int

  @@index([profesionalId, diaSemana])
  @@map("horarios_laborales")
}

// Identidad del paciente: mismo teléfono y mismo nombre (sin acentos ni mayúsculas).
// Mismo teléfono con otro nombre es otro paciente: la madre que reserva para su hijo con su móvil.
model Paciente {
  id          String    @id @default(cuid())
  nombre      String
  nombreNorm  String // normalizarNombre(nombre); también sirve para buscar sin acentos
  telefono    String
  email       String?
  notas       String? // internas, de la ficha. No es historia clínica.
  creadoAt    DateTime  @default(now())
  // Derecho de supresión: se vacían sus datos y los de sus citas, que se quedan para que la agenda pasada cuadre.
  eliminadoAt DateTime?
  citas       Cita[]

  @@unique([telefono, nombreNorm])
  @@map("pacientes")
}

model Cita {
  id                    String           @id @default(cuid())
  servicioId            String
  servicio              Servicio         @relation(fields: [servicioId], references: [id])
  profesionalId         String
  profesional           Profesional      @relation(fields: [profesionalId], references: [id])
  inicio                DateTime // UTC
  fin                   DateTime
  estado                EstadoCita       @default(CONFIRMADA)
  // Precio del servicio al reservar: los ingresos de meses pasados no cambian si luego cambia la tarifa.
  precioCent            Int              @default(0)
  pacienteId            String
  paciente              Paciente         @relation(fields: [pacienteId], references: [id])
  // Foto de lo que se escribió al reservar; la ficha viva está en Paciente.
  pacienteNombre        String
  pacienteTelefono      String
  pacienteEmail         String? // opcional en citas creadas desde el panel (teléfono, mostrador)
  notas                 String? // notas internas de la clínica, nunca se muestran al paciente
  tokenCancelacion      String           @unique
  recordatorioEnviadoAt DateTime?
  canceladaAt           DateTime?
  creadaAt              DateTime         @default(now())
  franjas               FranjaOcupada[]
  emails                EmailEnviado[]
  mensajes              MensajeEnviado[]

  @@index([profesionalId, inicio])
  @@index([estado, inicio])
  @@index([pacienteId, inicio])
  @@map("citas")
}

// Anti doble reserva: una fila por cada franja de 15 min que ocupa una cita activa.
// La clave primaria (profesional, inicio) hace imposible que dos citas se pisen.
model FranjaOcupada {
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  inicio        DateTime
  citaId        String
  cita          Cita        @relation(fields: [citaId], references: [id], onDelete: Cascade)

  @@id([profesionalId, inicio])
  @@index([citaId])
  @@map("franjas_ocupadas")
}

model Bloqueo {
  id            String       @id @default(cuid())
  profesionalId String? // null = toda la clínica
  profesional   Profesional? @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  inicio        DateTime
  fin           DateTime
  motivo        String
  creadoAt      DateTime     @default(now())

  @@index([inicio, fin])
  @@map("bloqueos")
}

model Usuario {
  id              String       @id @default(cuid())
  email           String       @unique
  nombre          String
  passwordHash    String
  rol             Rol          @default(EQUIPO)
  demo            Boolean      @default(false) // usuarios de la demo pública: no se pueden borrar ni cambiar
  // Enlace de un solo uso para poner contraseña (invitación o recuperación). Se guarda solo el hash.
  accesoTokenHash String?      @unique
  accesoExpira    DateTime?
  profesionalId   String? // si está ligado a un profesional, su agenda se abre filtrada
  profesional     Profesional? @relation(fields: [profesionalId], references: [id], onDelete: SetNull)
  // Las sesiones abiertas antes de esta fecha dejan de valer: se pone al cambiar la contraseña.
  sesionesDesde   DateTime     @default(now())
  auditoria       Auditoria[]

  @@map("usuarios")
}

model EmailEnviado {
  id        String     @id @default(cuid())
  tipo      TipoEmail
  canal     CanalEmail
  para      String
  asunto    String
  html      String
  error     String?
  citaId    String?
  cita      Cita?      @relation(fields: [citaId], references: [id], onDelete: SetNull)
  enviadoAt DateTime   @default(now())

  @@index([enviadoAt])
  @@map("emails_enviados")
}

// Límite de intentos (login, reserva web, recuperar contraseña): un contador por clave y ventana de tiempo.
// En la propia base de datos porque en Vercel no hay memoria compartida entre funciones.
model Intento {
  clave   String // "login:203.0.113.7"
  ventana DateTime // inicio de la ventana
  cuenta  Int      @default(1)

  @@id([clave, ventana])
  @@index([ventana])
  @@map("intentos")
}

// Registro de actividad: quién abrió o cambió qué. Nunca lleva datos del paciente (solo ids y nombres de campos),
// para que sobreviva a una supresión sin guardar lo que se pidió borrar.
model Auditoria {
  id           String   @id @default(cuid())
  creadoAt     DateTime @default(now())
  usuarioId    String?
  usuario      Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioEmail String // foto: sobrevive al borrado del usuario
  accion       String // VER, CREAR, EDITAR, BORRAR, EXPORTAR, MOVER, CANCELAR, ESTADO, ENTRAR
  entidad      String // paciente, cita, usuario, configuracion, bloqueo, sesion
  entidadId    String?
  detalle      String?

  @@index([creadoAt])
  @@index([entidad, entidadId])
  @@map("auditoria")
}

// Mensajes al móvil (Twilio). Igual que los emails: sin credenciales van a la consola, y siempre quedan aquí.
model MensajeEnviado {
  id          String       @id @default(cuid())
  tipo        TipoEmail
  canal       CanalMensaje
  para        String // teléfono, en E.164
  texto       String
  error       String?
  // Id del mensaje en Twilio. El fallo de un WhatsApp (por ejemplo, el número no tiene WhatsApp) llega después,
  // por webhook, con este id: entonces se apunta el error y sale el SMS de reserva.
  proveedorId String?      @unique
  citaId      String?
  cita        Cita?        @relation(fields: [citaId], references: [id], onDelete: SetNull)
  enviadoAt   DateTime     @default(now())

  @@index([enviadoAt])
  @@map("mensajes_enviados")
}
