generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum EstadoCita {
  CONFIRMADA
  CANCELADA
  ATENDIDA
  NO_PRESENTADA
}

enum TipoEmail {
  CONFIRMACION_PACIENTE
  AVISO_CLINICA
  RECORDATORIO
  CANCELACION
  MODIFICACION
  ACCESO // invitación al panel o cambio de contraseña
}

enum Rol {
  ADMIN // además: configuración y usuarios
  EQUIPO // agenda, citas, pacientes, bloqueos y emails
}

enum CanalEmail {
  RESEND
  CONSOLA
}

model Profesional {
  id       String           @id @default(cuid())
  slug     String           @unique
  nombre   String
  titulo   String
  bio      String
  orden    Int              @default(0)
  activo   Boolean          @default(true)
  usuarios Usuario[]
  horarios HorarioLaboral[]
  citas    Cita[]
  bloqueos Bloqueo[]
  franjas  FranjaOcupada[]

  @@map("profesionales")
}

model Servicio {
  id          String  @id @default(cuid())
  slug        String  @unique
  nombre      String
  descripcion String
  duracionMin Int
  precioCent  Int
  orden       Int     @default(0)
  activo      Boolean @default(true)
  citas       Cita[]

  @@map("servicios")
}

// Un tramo de trabajo. L-V son dos filas por día (mañana y tarde).
model HorarioLaboral {
  id            String      @id @default(cuid())
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  diaSemana     Int // 1 = lunes … 7 = domingo
  minInicio     Int // minutos desde medianoche, hora de Madrid (540 = 9:00)
  minFin        Int

  @@index([profesionalId, diaSemana])
  @@map("horarios_laborales")
}

// Identidad del paciente: mismo teléfono y mismo nombre (sin acentos ni mayúsculas).
// Mismo teléfono con otro nombre es otro paciente: la madre que reserva para su hijo con su móvil.
model Paciente {
  id         String   @id @default(cuid())
  nombre     String
  nombreNorm String // normalizarNombre(nombre); también sirve para buscar sin acentos
  telefono   String
  email      String?
  notas      String? // internas, de la ficha. No es historia clínica.
  creadoAt   DateTime @default(now())
  citas      Cita[]

  @@unique([telefono, nombreNorm])
  @@map("pacientes")
}

model Cita {
  id                    String          @id @default(cuid())
  servicioId            String
  servicio              Servicio        @relation(fields: [servicioId], references: [id])
  profesionalId         String
  profesional           Profesional     @relation(fields: [profesionalId], references: [id])
  inicio                DateTime // UTC
  fin                   DateTime
  estado                EstadoCita      @default(CONFIRMADA)
  pacienteId            String
  paciente              Paciente        @relation(fields: [pacienteId], references: [id])
  // Foto de lo que se escribió al reservar; la ficha viva está en Paciente.
  pacienteNombre        String
  pacienteTelefono      String
  pacienteEmail         String? // opcional en citas creadas desde el panel (teléfono, mostrador)
  notas                 String? // notas internas de la clínica, nunca se muestran al paciente
  tokenCancelacion      String          @unique
  recordatorioEnviadoAt DateTime?
  canceladaAt           DateTime?
  creadaAt              DateTime        @default(now())
  franjas               FranjaOcupada[]
  emails                EmailEnviado[]

  @@index([profesionalId, inicio])
  @@index([estado, inicio])
  @@index([pacienteId, inicio])
  @@map("citas")
}

// Anti doble reserva: una fila por cada franja de 15 min que ocupa una cita activa.
// La clave primaria (profesional, inicio) hace imposible que dos citas se pisen.
model FranjaOcupada {
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  inicio        DateTime
  citaId        String
  cita          Cita        @relation(fields: [citaId], references: [id], onDelete: Cascade)

  @@id([profesionalId, inicio])
  @@index([citaId])
  @@map("franjas_ocupadas")
}

model Bloqueo {
  id            String       @id @default(cuid())
  profesionalId String? // null = toda la clínica
  profesional   Profesional? @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  inicio        DateTime
  fin           DateTime
  motivo        String
  creadoAt      DateTime     @default(now())

  @@index([inicio, fin])
  @@map("bloqueos")
}

model Usuario {
  id              String       @id @default(cuid())
  email           String       @unique
  nombre          String
  passwordHash    String
  rol             Rol          @default(EQUIPO)
  demo            Boolean      @default(false) // usuarios de la demo pública: no se pueden borrar ni cambiar
  // Enlace de un solo uso para poner contraseña (invitación o recuperación). Se guarda solo el hash.
  accesoTokenHash String?      @unique
  accesoExpira    DateTime?
  profesionalId   String? // si está ligado a un profesional, su agenda se abre filtrada
  profesional     Profesional? @relation(fields: [profesionalId], references: [id], onDelete: SetNull)

  @@map("usuarios")
}

model EmailEnviado {
  id        String     @id @default(cuid())
  tipo      TipoEmail
  canal     CanalEmail
  para      String
  asunto    String
  html      String
  error     String?
  citaId    String?
  cita      Cita?      @relation(fields: [citaId], references: [id], onDelete: SetNull)
  enviadoAt DateTime   @default(now())

  @@index([enviadoAt])
  @@map("emails_enviados")
}

// Límite de intentos (login, reserva web, recuperar contraseña): un contador por clave y ventana de tiempo.
// En la propia base de datos porque en Vercel no hay memoria compartida entre funciones.
model Intento {
  clave   String // "login:203.0.113.7"
  ventana DateTime // inicio de la ventana
  cuenta  Int      @default(1)

  @@id([clave, ventana])
  @@index([ventana])
  @@map("intentos")
}
