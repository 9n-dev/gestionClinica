# Modo demo: contraseñas a la vista en el login, `npm run seed`, reinicio diario de los datos y avisos de demo.
# En una clínica real, déjalo vacío: así ni el seed ni el cron de reinicio pueden borrar nada.
MODO_DEMO="1"

# Base de datos. Local: fichero SQLite. Producción: Turso (libsql://…) + token.
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""

# Auth.js — genera uno con: npx auth secret
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# URL pública (para los enlaces de los emails)
APP_URL="http://localhost:3000"

# Resend. Si RESEND_API_KEY está vacío, los emails se escriben en consola
# y quedan guardados en la tabla emails_enviados (visible en /panel/emails).
RESEND_API_KEY=""
EMAIL_FROM="Podología Serrano <citas@podologiaserrano.es>"
EMAIL_CLINICA="clinica@podologiaserrano.es"

# Twilio: recordatorios por WhatsApp y, si no llega, por SMS. Sin SID y token, los mensajes se escriben en consola
# y quedan guardados en mensajes_enviados (visibles en el panel). Números en formato +34…
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
# Content SID (HX…) de la plantilla aprobada, con los huecos {{1}} nombre, {{2}} día, {{3}} hora, {{4}} profesional, {{5}} enlace
TWILIO_WHATSAPP_PLANTILLA=""

# Plazos de conservación, en meses; los aplica el cron diario. 0 = no borrar nunca.
# RETENCION_CANCELADAS_MESES="12"   # citas canceladas (lo que dice la política de privacidad)
# RETENCION_MENSAJES_MESES="12"     # copia guardada de emails y mensajes
# RETENCION_ACTIVIDAD_MESES="24"    # registro de actividad
# RETENCION_PACIENTES_MESES=""      # pacientes sin citas en ese tiempo: se anonimizan. Sin valor por defecto: decídelo con tu asesoría

# Protege /api/cron/*. Vercel Cron lo envía como "Authorization: Bearer …"
CRON_SECRET="cambia-esto-tambien"

# Datos de la clínica. Sin definir, salen los de la clínica ficticia de la demo.
# CLINICA_NOMBRE="Podología Serrano"
# CLINICA_RAZON_SOCIAL="Podología Serrano, S.L.P."
# CLINICA_NIF="B-00000000"
# CLINICA_DIRECCION="Calle Madrid, 48, local 2"
# CLINICA_CP="28901"
# CLINICA_CIUDAD="Getafe"
# CLINICA_PROVINCIA="Madrid"
# CLINICA_TELEFONO="910 000 000"
# CLINICA_EMAIL="hola@podologiaserrano.es"
# CLINICA_LAT="40.3083"
# CLINICA_LON="-3.7327"
